<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/player_shell" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black" android:clickable="true" android:focusable="true">
    <androidx.media3.ui.PlayerView android:id="@+id/player_view" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false" android:focusable="false" android:keepScreenOn="true" app:show_buffering="never" app:use_controller="false" />
    <ProgressBar android:id="@+id/player_buffering" style="?android:attr/progressBarStyleLarge" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:indeterminate="true" android:indeterminateTint="?attr/colorPrimary" android:visibility="gone" />
    <View android:id="@+id/player_center_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/player_center_scrim" />
    <LinearLayout android:id="@+id/player_top_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/player_overlay_top" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
        <ImageButton android:id="@+id/player_close" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/player_v2_round_button" android:contentDescription="Kembali" android:padding="11dp" android:src="@drawable/ic_player_back" android:tint="#FFFFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:orientation="vertical">
            <TextView android:id="@+id/player_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:maxLines="1" android:text="Anime" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:textColor="#CCFFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/player_quality" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/player_v2_chip" android:fontFamily="sans-serif-medium" android:gravity="center" android:minWidth="56dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="HD" android:textColor="#FFFFFFFF" android:textSize="13sp" android:layout_marginStart="4dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="110dp" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/player_center_controls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/player_rewind" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/player_v2_round_button" android:contentDescription="Mundur 10 detik" android:padding="17dp" android:src="@drawable/ic_player_rewind" android:layout_marginEnd="12dp" android:tint="#FFFFFFFF" android:visibility="gone" />
        <ImageButton android:id="@+id/player_previous" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/player_v2_round_button" android:contentDescription="Episode sebelumnya" android:padding="14dp" android:src="@drawable/ic_player_previous" android:tint="#FFFFFFFF" android:layout_marginEnd="12dp" />
        <ImageButton android:id="@+id/player_play_pause" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/player_v2_round_button" android:contentDescription="Play pause" android:padding="20dp" android:src="@drawable/ic_player_play" android:tint="#FFFFFFFF" />
        <ImageButton android:id="@+id/player_next" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/player_v2_round_button" android:contentDescription="Episode berikutnya" android:padding="14dp" android:src="@drawable/ic_player_next" android:tint="#FFFFFFFF" android:layout_marginStart="12dp" />
        <ImageButton android:id="@+id/player_forward" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/player_v2_round_button" android:contentDescription="Maju 10 detik" android:padding="17dp" android:src="@drawable/ic_player_forward" android:layout_marginStart="12dp" android:tint="#FFFFFFFF" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/player_bottom_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/player_overlay_bottom" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <ImageButton android:id="@+id/player_rotate" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/player_v2_round_button" android:src="@drawable/ic_player_rotate_portrait" android:tint="#FFFFFFFF" android:padding="9dp" android:contentDescription="Putar layar" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/player_speed" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/player_v2_chip" android:fontFamily="sans-serif-medium" android:gravity="center" android:minWidth="56dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="1.00x" android:textColor="#FFFFFFFF" android:textSize="13sp" android:clickable="true" android:focusable="true" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/player_scale" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/player_v2_chip" android:fontFamily="sans-serif-medium" android:gravity="center" android:minWidth="56dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Normal" android:textColor="#FFFFFFFF" android:textSize="13sp" android:layout_marginStart="8dp" android:clickable="true" android:focusable="true" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:id="@+id/player_position" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:text="00:00" android:textColor="#FFFFFFFF" android:textSize="12sp" />
            <SeekBar android:id="@+id/player_seek" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:max="1000" android:paddingStart="12dp" android:paddingEnd="12dp" android:progressDrawable="@drawable/player_v2_seek_progress" android:splitTrack="false" android:thumb="@drawable/player_v2_seek_thumb" />
            <TextView android:id="@+id/player_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:fontFeatureSettings="tnum" android:text="--:--" android:textColor="#CCFFFFFF" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageButton android:id="@+id/player_lock" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical|end" android:background="@drawable/player_v2_round_button" android:contentDescription="Kunci layar" android:padding="11dp" android:src="@drawable/ic_player_unlock" android:layout_marginEnd="16dp" android:tint="#FFFFFFFF" />
    <TextView android:id="@+id/player_locked_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/player_locked_hint" android:fontFamily="sans-serif-medium" android:paddingStart="18dp" android:paddingTop="10dp" android:paddingEnd="18dp" android:paddingBottom="10dp" android:text="Player terkunci" android:textColor="#FFFFFFFF" android:textSize="14sp" android:visibility="gone" />
</FrameLayout>
